    <string name="keep_ready_title">Keep the engine ready</string>
    <string name="keep_ready_desc">The engine stays in memory with a “Running…” notification: instant start and reliable screen-off reading on Huawei. Off: memory is freed 3 minutes after reading and the system may close the process.</string>
    <string name="roles_title">Reading by roles</string>
    <string name="roles_desc">Built-in reader: author text by the narrator, male and female lines in their own voices. Gender comes from the author words (said, he or she) and from names the book itself reveals.</string>
    <string name="roles_characters_title">A voice for every character</string>
    <string name="roles_characters_desc">Characters (Peter, Lena, the old man, the computer…) get different voices automatically and keep them in every chapter. Their pace follows the text: old people slower, «blurted out» faster, «whispered» quieter. Off: voices by gender only.</string>
    <string name="roles_narrator">Narrator</string>
    <string name="roles_narrator_main">as on the main screen</string>
    <string name="roles_male">Male lines</string>
    <string name="roles_female">Female lines</string>
    <string name="punct_pause_scale_title">Pause length</string>
    <string name="punct_pause_scale_desc">Pauses after . ! ? : ; — … and around (brackets). ×1 is the default; ×0 leaves only the voice model’s own pauses.</string>
    <string name="punct_paragraph_pause_title">Pause between paragraphs</string>
    <string name="punct_paragraph_pause_desc">Silence after the last sentence of a paragraph, in seconds. Used when the reader sends whole paragraphs (FBReader does).</string>
    <string name="punct_force_space_title">Force space before punctuation</string>
    <string name="punct_force_space_desc">Insert a space between any word and a trailing `.,;:!?`. Belt-and-braces hint for the model\'s text tokenizer (`удивлён,` → `удивлён ,`). Leaves consecutive marks (`...`, `?!`) and numbers (`3,14`, `1.5`) alone. Off by default.</string>
    <string name="chunk_size_title">Chunk size</string>
    <string name="chunk_size_desc">Small (120) — quick start for short messages. Default (300) — balanced, current behavior. Large (500) — smoother intonation, best for books. Huge (1000, experimental) — packs whole short paragraphs into one synthesis call.</string>
    <string name="chunk_size_small">Small</string>
    <string name="chunk_size_default">Default</string>
    <string name="chunk_size_large">Large</string>
    <string name="chunk_size_huge">Huge</string>
    <string name="preroll_title">Pre-roll buffer</string>
    <string name="preroll_desc">Build up several sentences of synthesized audio in RAM (~1-3 MB) before playback starts. Smooths out pauses between sentences on weak devices. Costs a longer wait at the very beginning of playback.</string>
    <string name="preroll_sentences_fmt">Sentences buffered before start: %1$d</string>

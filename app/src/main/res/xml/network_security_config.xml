<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0–7.1 does not know the root certificates that Hugging Face, GitHub and
     Let's Encrypt sites use now ("Trust anchor for certification path not found" when
     the models are downloaded): the app brings those roots itself, besides the system ones. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/extra_roots" />
        </trust-anchors>
    </base-config>
</network-security-config>
